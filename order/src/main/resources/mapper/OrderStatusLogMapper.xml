<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.b2cmall.order.dao.mapper.OrderStatusLogMapper">
    <insert id="insert">
        INSERT INTO tb_order_status_log(order_id,shop_id,user_id,from_status,to_status,event)
        VALUES(#{orderId},#{shopId},#{userId},#{fromStatus},#{toStatus},#{event})
    </insert>
</mapper>
